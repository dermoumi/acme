{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posy-dev",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-07-01",
  // @sentry/cloudflare needs AsyncLocalStorage for its per-request client.
  "compatibility_flags": ["nodejs_als"],
  "vars": {
    "APP_NAME": "posy",
    "APP_ENV": "development",
    "APP_VERSION": "dev",
    "APP_REVISION": "dev"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Local dev only; the named envs below get their ids from CI.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "posy",
      "database_id": "posy-local"
    }
  ],
  // namespace_id must be NUMERIC despite the schema typing it as a string:
  // wrangler forwards it unvalidated and the API rejects anything else (10021).
  // Self-chosen, nothing to provision. 0xxx dev, 1xxx production, 2xxx staging.
  "ratelimits": [
    {
      "name": "RATE_LIMIT_LOGIN",
      "namespace_id": "0001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_SENTRY",
      "namespace_id": "0002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "env": {
    "staging": {
      "name": "staging",
      // vars are replaced wholesale per env, never merged with the top-level block.
      "vars": {
        "REQUIRE_AUTH": "1",
        "APP_ENV": "staging"
      },
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      // CI resolves by name and patches the id in; see target-cloudflare.yml.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "posy-staging",
          "database_id": "set-by-ci"
        }
      ],
      // Repeated because binding blocks are replaced per env, never merged.
      "ratelimits": [
        {
          "name": "RATE_LIMIT_LOGIN",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_SENTRY",
          "namespace_id": "2002",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "play",
      "vars": {
        "APP_ENV": "production"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "posy", "database_id": "set-by-ci" }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMIT_LOGIN",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_SENTRY",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  }
}
