{
  "name": "@acme/assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#assets": {
      "workerd": "./src/assets/assets.workerd.ts",
      "default": "./src/assets/assets.node.ts"
    },
    "#testing/runtime": {
      "workerd": "./src/testing/runtime/runtime.workerd.ts",
      "default": "./src/testing/runtime/runtime.node.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxfmt -c ../../.oxfmtrc.json --check . && oxlint -c ../../.oxlintrc.json . && tsc -b",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix . && oxfmt -c ../../.oxfmtrc.json .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@acme/app": "workspace:*"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@hono/node-server": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@hono/node-server": "catalog:",
    "hono": "catalog:"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    }
  }
}
