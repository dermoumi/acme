{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["packages/tsconfig/tsconfig.*.json"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint:root": {
      "outputLogs": "errors-only",
      "inputs": ["$TURBO_DEFAULT$", "!apps/**", "!packages/**"]
    },
    "//#lint:fix:root": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,css}",
        "*.json",
        ".gitignore",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.oxfmtrc.json",
        "$TURBO_ROOT$/.oxlintrc.json"
      ]
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,css}",
        "vite.config.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        ".gitignore",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/package.json"
      ]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,css}",
        "vite.config.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        ".gitignore",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/package.json"
      ],
      "outputs": ["coverage/**/*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CLOUDFLARE_ENV",
        "APP_NAME",
        "APP_ENV",
        "APP_REVISION",
        "APP_VERSION",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ],
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,css}",
        "!src/**/*.{test,stories}.{ts,tsx}",
        "vite.config.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        ".gitignore",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/package.json"
      ],
      "outputs": ["dist/**", ".output/**"]
    }
  }
}
