{
  "extends": "@acme/tsconfig/tsconfig.workerd.json",
  "compilerOptions": {
    // Resolve #runtime the way workerd does, so node-only imports stay out.
    "customConditions": ["workerd"]
  },
  "include": ["src"],
  // The CLI and its commands are node-only; tsconfig.node.json checks those.
  "exclude": [
    "**/*.node.ts",
    "**/*.node.test.ts",
    "src/cli/**",
    "src/internal/commands/**"
  ]
}
