{
  "name": "@acme/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "turbo run lint lint:root",
    "lint:root": "oxfmt -c .oxfmtrc.json --ignore-path .lintignore.root --check . && oxlint -c .oxlintrc.json --ignore-path .lintignore.root --no-error-on-unmatched-pattern .",
    "lint:fix": "turbo run lint:fix lint:fix:root",
    "lint:fix:root": "oxlint -c .oxlintrc.json --ignore-path .lintignore.root --no-error-on-unmatched-pattern --fix . && oxfmt -c .oxfmtrc.json --ignore-path .lintignore.root .",
    "build": "turbo build",
    "test": "turbo test",
    "test:cov": "turbo test:cov",
    "dev": "turbo dev"
  },
  "devDependencies": {
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
