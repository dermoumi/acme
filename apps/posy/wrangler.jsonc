{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posy-dev",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Local dev only; the named envs below get their ids from CI.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "posy",
      "database_id": "posy-local"
    }
  ],
  "env": {
    "staging": {
      "name": "staging",
      "vars": {
        "REQUIRE_AUTH": "1"
      },
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      // CI resolves by name and patches the id in; see target-cloudflare.yml.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "posy-staging",
          "database_id": "set-by-ci"
        }
      ]
    },
    "production": {
      "name": "play",
      "d1_databases": [
        { "binding": "DB", "database_name": "posy", "database_id": "set-by-ci" }
      ]
    }
  }
}
