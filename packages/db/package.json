{
  "name": "@acme/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#runtime": {
      "workerd": "./src/runtime/runtime.workerd.ts",
      "default": "./src/runtime/runtime.node.ts"
    },
    "#testing/runtime": {
      "workerd": "./src/testing/runtime/runtime.workerd.ts",
      "default": "./src/testing/runtime/runtime.node.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./d1": "./src/d1/index.ts"
  },
  "scripts": {
    "lint": "oxfmt -c ../../.oxfmtrc.json --check . && oxlint -c ../../.oxlintrc.json . && tsc -b",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix . && oxfmt -c ../../.oxfmtrc.json .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "kysely": "catalog:",
    "kysely-d1": "catalog:"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "better-sqlite3": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "better-sqlite3": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
