{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posy-dev",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Local dev only: named envs get real cloud ids in a follow-up task.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "posy",
      "database_id": "posy-local"
    }
  ],
  "env": {
    "staging": {
      "name": "staging",
      "vars": {
        "REQUIRE_AUTH": "1"
      },
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      }
    },
    "production": {
      "name": "play"
    }
  }
}
