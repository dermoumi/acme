{
  "extends": "@acme/tsconfig/tsconfig.react.json",
  "compilerOptions": {
    // Route loaders and actions run on the server, and reach into src/server.
    "customConditions": ["workerd"],
    "rootDirs": [".", "./.react-router/types"],
    "types": [
      "@cloudflare/workers-types",
      "vite/client",
      "vite-plugin-pwa/react"
    ]
  },
  "include": ["src/client", ".react-router/types/**/*"]
}
