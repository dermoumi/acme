{
  "extends": "@acme/tsconfig/tsconfig.workerd.json",
  "compilerOptions": {
    // Resolve #runtime the way workerd does, so node-only imports stay out.
    "customConditions": ["workerd"]
  },
  "include": ["src"],
  // The CLI is node-only; tsconfig.node.json checks it.
  "exclude": ["**/*.node.ts", "**/*.node.test.ts", "src/cli/**"]
}
