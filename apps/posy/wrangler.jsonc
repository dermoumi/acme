{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posy-dev",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "staging"
    },
    "production": {
      "name": "posy"
    }
  }
}
